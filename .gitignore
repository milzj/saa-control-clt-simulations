# Study outputs and run logs: a new run's <stamp> folder stays untracked, so local
# runs never dirty the tree.  The runs behind the manuscript are committed anyway
# (added with `git add -f`), so this does not apply to them -- ignore rules have no
# effect on files that are already tracked.
/results/*
!/results/.gitkeep
!/results/revision/
/results/revision/*
!/results/revision/fed-batch-mean-subsampling-width-N32-R30.pdf
!/results/revision/fed-batch-mean-subsampling-width-N32-R30.png
!/results/revision/fed-batch-mean-subsampling-width-N64-R30.pdf
!/results/revision/fed-batch-mean-subsampling-width-N64-R30.png
!/results/revision/subsampling_width_monte_carlo.json
!/results/revision/subsampling_width_monte_carlo_summary95.csv
!/results/revision/coverage_replications.json
!/results/revision/coverage_plugin.tex
!/results/revision/coverage_plugin_t.tex
/logs/*
!/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.DS_Store
.idea/
.vscode/
